{
    "hosting": {
        "public": "dist",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "redirects": [
            {
                "source": "/privacy/en",
                "destination": "REPLACE_WITH_IUBENDA_EN_POLICY_URL",
                "type": 301
            },
            {
                "source": "/privacy",
                "destination": "REPLACE_WITH_IUBENDA_IT_POLICY_URL",
                "type": 301
            }
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "firestore": {
        "rules": "firestore.rules"
    }
}
