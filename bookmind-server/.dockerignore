# Keep secrets, local environments and everything that is not the app out of the build context.
# The Dockerfile also copies only the application modules by name.

# secrets
.env
.env.*
*.pem
*.key
*.p12
*service-account*.json
*serviceAccount*.json
*credentials*.json

# local environments and caches
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# not needed at run time
tests/
pytest.ini
requirements-dev.txt
Dockerfile
.dockerignore
README.md
DEPLOY.md
scripts/
.git
.gitignore
*.log
.DS_Store
