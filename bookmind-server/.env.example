# Backend settings. Copy to bookmind-server/.env (never commit that file).
# The root .env.example is for the Vite app; this one is for the FastAPI service.

# Required. Used when LLM_API_KEY is not set.
OPENAI_API_KEY=your_openai_api_key

# Defaults, when nothing below is set: OpenAI, model gpt-4o-mini, output limit sent as max_tokens,
# json_object response format on /recommendations only.
#
# Production runs gpt-6-luna with reasoning off (DEPLOY.md, card #73). These three lines reproduce it
# locally. They only work together: gpt-6-luna rejects max_tokens, and accepts a temperature other
# than 1 only with reasoning_effort "none". Uncomment all three or none.
# LLM_MODEL=gpt-6-luna
# LLM_TOKEN_LIMIT_PARAM=max_completion_tokens
# LLM_EXTRA_BODY={"reasoning_effort":"none"}

# Other providers (OpenRouter, ...): see README.md, "LLM provider".
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_JSON_MODE=true

# Optional.
# DAILY_LLM_CALL_LIMIT=10
# DAILY_REPORT_LIMIT=20
# CORS_ALLOWED_ORIGINS=http://localhost:5173
