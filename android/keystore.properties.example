# Copy to android/keystore.properties (git-ignored) and fill in. Never commit the real file.
# The environment variables BOOKMIND_UPLOAD_STORE_FILE, BOOKMIND_UPLOAD_STORE_PASSWORD,
# BOOKMIND_UPLOAD_KEY_ALIAS and BOOKMIND_UPLOAD_KEY_PASSWORD take precedence over these values.
# storeFile is resolved relative to android/ unless it is an absolute path.
storeFile=/absolute/path/outside/the/repo/bookmind-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
