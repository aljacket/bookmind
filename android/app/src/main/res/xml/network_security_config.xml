<?xml version="1.0" encoding="utf-8"?>
<!-- Release (and default) network policy: system CAs only, no cleartext.
     The debug build overrides this file with src/debug/res/xml/network_security_config.xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
