rules_version = '2';

// BookMind keeps no client-readable data in Firestore. The only collection, llmQuota, is read and
// written by the backend through the Admin SDK, which bypasses these rules and is governed by IAM.
// Denying everything stops a signed-in user from editing their own daily counter from the app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
